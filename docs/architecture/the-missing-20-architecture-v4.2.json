  "cards": [
    {
      "dot": "amber",
      "title": "Synthetic SAP-shaped Main Case",
      "items": [
        "The second HU's 20 EA message enters DOCUMENT_LOCKED_RETRYABLE because of a concurrency lock; the lock is cleared, the original message can be retried, and there is no material document",
        "The system restarts only the original message; at-least-once delivery and the idempotency key together guarantee one business effect"
      ]
    },
    {
      "dot": "rose",
      "title": "Signed Authorization and Rejection Conditions",
      "items": [
        "A one-time authorization binds principal, role, case_version, tool, complete parameters, summary, and TTL",
        "The executor acts only after a fresh read; any signature, version, summary, or state change fails closed; the Agent and frontend have no write credentials"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dual-Approval Loop and Counterexample",
      "items": [
        "Principal A restarts and verifies ERP=100; Principal B releases the invoice and verifies Invoice=Released before the case becomes Closed",
        "If already posted before approval, reject the restart; if state drifts after authorization, safely no-op; neither can create a duplicate document"
      ]
    }
  ]
