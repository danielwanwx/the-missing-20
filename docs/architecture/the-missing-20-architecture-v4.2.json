  "cards": [
    {
      "dot": "amber",
      "title": "合成 SAP-shaped 主案例",
      "items": [
        "第二个 HU 的 20 EA 消息因并发锁进入 DOCUMENT_LOCKED_RETRYABLE；锁已解除、原消息可重试且没有 material document",
        "系统只重启原消息；at-least-once 传输与幂等键共同保证单一业务效果"
      ]
    },
    {
      "dot": "rose",
      "title": "签名授权与拒绝条件",
      "items": [
        "单次授权绑定 principal、role、case_version、tool、完整参数、摘要与 TTL",
        "执行器 fresh-read 后才行动；签名、版本、摘要或状态变化均 fail closed；Agent 与前端没有写凭证"
      ]
    },
    {
      "dot": "emerald",
      "title": "双审批闭环与反例",
      "items": [
        "Principal A 重启并验证 ERP=100；Principal B 释放发票并验证 Invoice=Released 后案件才 Closed",
        "审批前已入账则拒绝重启；授权后状态漂移则安全 no-op；两者都不能产生重复凭证"
      ]
    }
  ]
