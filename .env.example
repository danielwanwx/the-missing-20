MISSING20_ENVIRONMENT=local
MISSING20_AWS_REGION=us-west-2
MISSING20_AWS_PROFILE=
MISSING20_EXPECTED_AWS_ACCOUNT_ID=
MISSING20_RESOURCE_PREFIX=missing20-dev
MISSING20_CLEANUP_MANIFEST=artifacts/aws/cleanup-manifest.json
MISSING20_MAX_AWS_SPEND_USD=5.00
MISSING20_ALLOW_AWS_MUTATIONS=0

# Advisory provider boundary. Keep `scripted` for the offline demo. `bedrock`
# selects the explicitly bounded Strands/Nova Pro adapter; `agentcore` selects an
# already-deployed AgentCore Runtime and fails visibly if its ARN is absent.
MISSING20_AGENT_PROVIDER=scripted
MISSING20_AGENTCORE_RUNTIME_ARN=
MISSING20_AGENTCORE_QUALIFIER=DEFAULT

# Optional live public route context. NWS/NOAA need no key. To activate AISStream
# on the server, install `pip install -e '.[live]'` and set this key; the browser
# never receives it. Without both, AIS remains explicitly optional/not configured.
AISSTREAM_API_KEY=
MISSING20_LIVE_SOURCES_AUTOSTART=0

# Optional read-only ERPNext evidence adapter. These values stay on the local
# server and are never returned to the browser. Seed demo data separately with
# `node scripts/seed_erpnext_case.mjs`; do not grant this user write privileges.
ERPNEXT_BASE_URL=
ERPNEXT_API_USER=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
MISSING20_ERPNEXT_PURCHASE_ORDER=PUR-ORD-2026-00011
MISSING20_ERPNEXT_PURCHASE_RECEIPT=MAT-PRE-2026-00001
MISSING20_ERPNEXT_PURCHASE_INVOICE=ACC-PINV-2026-00007

# Optional read-only multi-SaaS evidence adapter. Every credential remains on
# the local server; browser responses contain only the redacted, correlated
# activity projection. Do not reuse the ERP executor credential here.
MISSING20_QUALITY_RELEASE_CORRELATION_ID=M20-ECU-2026-00011-LOT-A
AIRTABLE_API_TOKEN=
AIRTABLE_DEMO_OPERATOR_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_QUALITY_RELEASE_TABLE=Supplier Quality Registry
AIRTABLE_INTEGRATION_RECEIPT_TABLE=Integration Receipts
CELIGO_EVIDENCE_URL=
CELIGO_API_TOKEN=
CELIGO_FLOW_ID=
JIRA_BASE_URL=
JIRA_API_EMAIL=
JIRA_API_TOKEN=
JIRA_CAPA_PROJECT_KEY=CAPA
# Optional for scoped Jira API tokens: uses Atlassian Gateway + Bearer auth.
JIRA_CLOUD_ID=
SLACK_BOT_TOKEN=
SLACK_INCIDENT_CHANNEL_ID=
